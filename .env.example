# PostgreSQL connection string.
# Locally: postgres://user:password@localhost:5432/escala
# On Railway: this is provided automatically as DATABASE_URL when you add the
# Postgres plugin to your project - you normally don't need to set it by hand.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/escala

# Secret used to sign session cookies. Use a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# Port the server listens on. Railway sets this automatically - leave unset there.
PORT=3000

# Set to "true" only if your Postgres provider requires SSL and you are
# having trouble connecting. Railway's internal DATABASE_URL usually works
# without this; Railway's public/proxy URL and most other managed Postgres
# providers need it.
PGSSL=false
